# Copy to .env (or export these). Never commit real values.
DATABASE_URL=sqlite:///./upnivo.db
# PostgreSQL: postgresql://user:pass@localhost:5432/upnivo
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=skillforgelearning22@gmail.com
ADMIN_PASSWORD=ruthira227227

# Razorpay (optional). If both keys are set, students pay online and the certificate unlocks automatically.
# Use TEST keys first (rzp_test_...), then switch to LIVE keys. Never put the secret in the frontend or on GitHub.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CERT_FEE=199
UPI_ID=

# Play Store (Trusted Web Activity). Fill after PWABuilder gives you the package id and signing SHA-256.
ANDROID_PACKAGE=
ANDROID_SHA256=

# Push notifications (run: python gen_vapid.py and paste both lines)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
