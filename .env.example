# Copy this file to .env and fill in the values required for your environment.
# Never commit real secrets or a production .env file to source control.

APP_ENV=development
DATABASE_URL=sqlite:///./upnivo.db
# Production example:
# DATABASE_URL=postgresql://upnivo:change-me@localhost:5432/upnivo

SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Razorpay (optional): use test keys first and rotate them regularly.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CERT_FEE=199
# Hours an unpaid Razorpay order stays open before it is marked Expired (a late payment on it is still honoured)
RAZORPAY_ORDER_TTL_HOURS=24
UPI_ID=
UPI_NAME=UPNIVO INTERN

# Web push notifications (generate with: python gen_vapid.py)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Upload storage
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=4000000
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=uploads
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,https://your-domain.com

# Public support contact shown in Terms / Privacy / Help (replaces the placeholder address). Use a real, monitored address.
SUPPORT_EMAIL=

# Android Digital Asset Links (see DIGITAL_ASSET_LINKS_GUIDE.md). Leave empty until you have your signing key fingerprints.
ANDROID_PACKAGE=com.upnivo.app
ANDROID_SHA256=
